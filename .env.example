PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=

# Any long random string works - used to sign JWTs
JWT_SECRET=
JWT_EXPIRES_IN=7d

# https://aistudio.google.com/apikey - both AIzaSy... (legacy) and
# AQ.Ab... (current, as of mid-2026) key formats work here, since this
# app passes the key straight to the official @google/generative-ai SDK
# with no format validation of its own.
GEMINI_API_KEY=
# gemini-2.0-flash was shut down by Google on June 1, 2026 - use
# gemini-3.6-flash (current as of August 2026) or check
# https://ai.google.dev/gemini-api/docs/changelog for the latest.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000

# https://data.gov.in - register free. If left blank, mandi prices fall
# back to clearly-labeled demo data instead of failing.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_TIMEOUT_MS=15000
